#!/bin/sh
set -e

case "$1" in
  remove|deconfigure)
    if command -v systemctl >/dev/null 2>&1; then
      systemctl --global disable openmacrosd.service >/dev/null 2>&1 || true
    fi
    ;;
esac

case "$1" in
  remove|upgrade|deconfigure)
    if command -v py3clean >/dev/null 2>&1; then
      py3clean -p openmacros-plus 2>/dev/null || true
    fi
    ;;
esac

exit 0
